{
  "name": "agentic-wiki",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test:browser": "playwright test",
    "test": "node --test tests/*.test.mjs",
    "example": "node scripts/example.mjs",
    "benchmark:serve": "node scripts/benchmark-serve.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "prettier --check . && npm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "3.9.6"
  },
  "description": "A small Git-backed Markdown wiki with native WebMCP and on-demand agent traces.",
  "license": "MIT",
  "author": "Chris Reynolds"
}
