{
  "name": "agentic-wiki",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test:browser": "playwright test",
    "test": "node --test tests/*.test.mjs",
    "example": "node scripts/example.mjs",
    "benchmark:serve": "node scripts/benchmark-serve.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "prettier --check . && npm run typecheck && npm test",
    "format": "prettier --write .",
    "typecheck": "tsc --project tsconfig.json",
    "build:ui": "node scripts/build-ui.mjs",
    "prepare": "npm run build:ui"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "esbuild": "0.28.2",
    "gray-matter": "4.0.3",
    "lowlight": "3.3.0",
    "mermaid": "11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "description": "A small Git-backed Markdown wiki with native WebMCP and on-demand agent traces.",
  "license": "MIT",
  "author": "Chris Reynolds"
}
